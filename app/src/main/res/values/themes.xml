<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Compose を使うので ActionBar なしのベーステーマにする -->
    <style name="Theme.JapanTripMap" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
      起動時のシステムスプラッシュ。core-splashscreen を使い、白背景の中間画面を
      出さずに最初から splash と同じティール地＋アイコンを表示する。
      postSplashScreenTheme で本体テーマに戻す。
    -->
    <style name="Theme.JapanTripMap.Splash" parent="Theme.SplashScreen">
        <!-- 円マスクで切られる windowSplashScreenAnimatedIcon は使わず、windowBackground に
             全画面の画像(splash_window)を指定して、見切れなく高解像度で表示する。 -->
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="postSplashScreenTheme">@style/Theme.JapanTripMap</item>
    </style>
</resources>
